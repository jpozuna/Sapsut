{
  "expo": {
    "name": "Sapsut",
    "slug": "Sapsut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sapsut-icon-1024.png",
    "scheme": "sapsut",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jpozuna.sapsut"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EC",
        "foregroundImage": "./assets/images/sapsut-adaptive-foreground-1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sapsut-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sapsut-splash-800x400.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDF6EC",
          "dark": {
            "backgroundColor": "#171310"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

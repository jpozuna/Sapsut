SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AUTO_APPROVE_CONFIDENCE_THRESHOLD=1.0
# Comma-separated list of allowed CORS origins (no "*"). Defaults to the local Expo dev origins.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006
# Organizer access code. Use 12+ random characters; rotating it signs out every organizer session.
ORGANIZER_DEMO_CODE=
